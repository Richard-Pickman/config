# run for interactive shells only
[[ $- != *i* ]] && return

PATH=~/bin:$PATH

if [[ "$(uname -s)" == "Darwin" ]]; then
  PATH=~/bin/bin_mac:$PATH
elif [[ "$(uname -s)" == "Linux" ]]; then
  PATH=~/bin/bin_linux:$PATH
fi

if [[ -f /usr/local/bin/nvim-linux-x86_64/bin/nvim ]]; then
  alias vi=/usr/local/bin/nvim-linux-x86_64/bin/nvim
elif [[ -f /usr/local/bin/nvim-linux-x86_64/bin/nvim ]]; then
  alias vi=/usr/local/bin/nvim-linux-arm64/bin/nvim
elif [[ -f /opt/homebrew/bin/nvim ]]; then
  alias vi=/opt/homebrew/bin/nvim
fi

alias c=clear
alias p=pwd
#alias l='ls -a -p -G'
#alias ls='ls -p -G'
alias l='ls -a -p --color=auto'
alias ls='ls -p --color=auto'
alias ..='echo "cd ..";cd ..'
alias type='type -a'
alias code='code --disable-gpu'

# vi mode
set -o vi

# prompt configuration
tput_available=false
TPUT_RESET=""
if [[ -f "$HOME/bin/tput_codes.bash" ]]; then
  source "$HOME/bin/tput_codes.bash"
  if [[ -n ${TPUT_RED-} && -n ${TPUT_RESET-} ]]; then
    tput_available=true
  fi
fi
prompt-minimal() {
  local prompt_color="" reset=""
  if [[ $tput_available == true ]]; then
    prompt_color=$TPUT_GREEN
    reset=$TPUT_RESET
  fi
  PS1="\[${prompt_color}\]$ \[${reset}\]"
}
prompt-standard() {
  local user="" at="" machine="" dir="" reset=""
  if [[ $tput_available == true ]]; then
    user=$TPUT_BRIGHT_MAGENTA
    at=$TPUT_GREEN
    machine=$TPUT_BRIGHT_MAGENTA
    dir=$TPUT_BRIGHT_BLUE
    reset=$TPUT_RESET
  fi
  # exit code of last process
  PS1="\[${user}\]\u\[${at}\]@\[${machine}\]\h ${dir}\w\[${reset}\] "
}
prompt-update() {
  if [ -n "$TMUX" ]; then
    prompt-minimal
  else
    prompt-standard
  fi
}
# Call our function right before the prompt is displayed.
PROMPT_COMMAND=prompt-update

# limit number of subdirectories to display
PROMPT_DIRTRIM=3

# display line number when debugging bash scripts
export PS4="+ \${LINENO} "

export CODEX_CONFIG_PATH="$HOME/.codex/config.toml"

export HISTCONTROL=ignoredups
export HISTSIZE=1000
export HISTFILESIZE=1000

#PROMPT_COMMAND='printf "\033]7;%s\007" "file://${PWD}"'

if [[ -f ~/bin_linux_main/calendar.py ]]; then
  ~/bin_linux_main/calendar.py
fi

source "$HOME/bin/cd"

~/motd.bash
